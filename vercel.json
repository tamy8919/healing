{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "ALLOWALL" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
    ] }
  ],
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/moon", "destination": "/api/moon.js" },
    { "source": "/api/delete-account", "destination": "/api/delete-account.js" }
  ]
}
